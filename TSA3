<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks For Today Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Navigation Header -->
    <header class="bg-indigo-600 text-white shadow-md">
        <div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center">
            <h1 class="text-xl font-bold flex items-center gap-2">
                <i class="fa-solid fa-list-check"></i> Tasks For Today
            </h1>
            <nav class="flex gap-2 mt-3 sm:mt-0 bg-indigo-700 p-1 rounded-lg">
                <button onclick="switchTab('welcome')" id="nav-welcome" class="px-4 py-2 rounded-md font-medium text-sm transition bg-white text-indigo-700 shadow">Welcome</button>
                <button onclick="switchTab('tasks')" id="nav-tasks" class="px-4 py-2 rounded-md font-medium text-sm transition hover:bg-indigo-600 text-white">All Tasks</button>
                <button onclick="switchTab('profile')" id="nav-profile" class="px-4 py-2 rounded-md font-medium text-sm transition hover:bg-indigo-600 text-white">Profile</button>
                <button onclick="switchTab('about')" id="nav-about" class="px-4 py-2 rounded-md font-medium text-sm transition hover:bg-indigo-600 text-white">About</button>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-5xl w-full mx-auto px-4 py-8 flex-grow">
        
        <!-- Welcome Tab -->
        <section id="tab-welcome" class="space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Welcome - Today's Tasks</h2>
                        <p class="text-sm text-slate-500">Showing tasks scheduled specifically for today (<span id="current-date"></span>).</p>
                    </div>
                    <button onclick="openAddTaskModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 shadow">
                        <i class="fa-solid fa-plus"></i> Add New Task
                    </button>
                </div>
                <div id="today-tasks-list" class="divide-y divide-slate-100">
                    <!-- Dynamic Today Tasks -->
                </div>
            </div>
        </section>

        <!-- All Tasks Tab -->
        <section id="tab-tasks" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">All Tasks</h2>
                        <p class="text-sm text-slate-500">Complete chronological record of all scheduled tasks ordered by date.</p>
                    </div>
                    <button onclick="openAddTaskModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2 shadow">
                        <i class="fa-solid fa-plus"></i> Add New Task
                    </button>
                </div>
                <div id="all-tasks-list" class="divide-y divide-slate-100">
                    <!-- Dynamic All Tasks -->
                </div>
            </div>
        </section>

        <!-- Profile Tab -->
        <section id="tab-profile" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 max-w-xl">
                <h2 class="text-2xl font-bold text-slate-900 mb-1">User Profile</h2>
                <p class="text-sm text-slate-500 mb-6">Account information retrieved from the database.</p>
                <div class="space-y-4">
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex justify-between items-center">
                        <span class="text-slate-500 font-medium text-sm">Username</span>
                        <span id="profile-username" class="font-semibold text-slate-800">xielefferareza</span>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex justify-between items-center">
                        <span class="text-slate-500 font-medium text-sm">Full Name</span>
                        <span id="profile-fullname" class="font-semibold text-slate-800">Xielef Ferareza</span>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 flex justify-between items-center">
                        <span class="text-slate-500 font-medium text-sm">Email Address</span>
                        <span id="profile-email" class="font-semibold text-indigo-600">xisferareza@gmail.com</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Tab -->
        <section id="tab-about" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 max-w-xl">
                <h2 class="text-2xl font-bold text-slate-900 mb-1">About the Developer</h2>
                <p class="text-sm text-slate-500 mb-6">System information and author credentials.</p>
                <div class="space-y-4 text-slate-700 leading-relaxed">
                    <p>This <strong class="text-slate-900">Tasks for Today Management System</strong> was engineered as part of web systems coursework, demonstrating robust front-end layout and database-backed architecture principles.</p>
                    <div class="p-4 bg-indigo-50 border border-indigo-100 rounded-lg flex items-center gap-3 text-indigo-900">
                        <i class="fa-solid fa-graduation-cap text-xl text-indigo-600"></i>
                        <div>
                            <p class="text-xs text-indigo-600 font-semibold uppercase tracking-wider">Developer</p>
                            <p class="font-bold text-lg">Xielef Ferareza</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Add Task Modal -->
    <div id="taskModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 animate-scale">
            <h3 class="text-lg font-bold text-slate-900 mb-4">Add New Task</h3>
            <form id="taskForm" onsubmit="handleAddTask(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Task Title</label>
                    <input type="text" id="taskTitle" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Task Date</label>
                    <input type="date" id="taskDate" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Status</label>
                    <select id="taskStatus" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                        <option value="pending">Pending</option>
                        <option value="completed">Completed</option>
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeAddTaskModal()" class="px-4 py-2 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium transition shadow">Save Task</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
        <p>&copy; 2026 Tasks For Today Management System &bull; Developed by Xielef Ferareza</p>
    </footer>

    <!-- App Logic -->
    <script>
        // Format today date in YYYY-MM-DD
        const todayStr = new Date().toISOString().split('T')[0];
        document.getElementById('current-date').innerText = todayStr;
        document.getElementById('taskDate').value = todayStr;

        // Initial Seed Tasks
        let tasks = JSON.parse(localStorage.getItem('tsa3_tasks')) || [
            { id: 1, title: 'Complete system analysis documentation', status: 'pending', task_date: todayStr },
            { id: 2, title: 'Review database schema relationships', status: 'completed', task_date: todayStr },
            { id: 3, title: 'Prepare project presentation slides', status: 'pending', task_date: '2026-11-10' },
            { id: 4, title: 'Test user authentication endpoints', status: 'completed', task_date: '2026-11-05' }
        ];

        function saveTasks() {
            localStorage.setItem('tsa3_tasks', JSON.stringify(tasks));
            renderTasks();
        }

        function switchTab(tabId) {
            ['welcome', 'tasks', 'profile', 'about'].forEach(t => {
                document.getElementById('tab-' + t).classList.add('hidden');
                document.getElementById('nav-' + t).className = 'px-4 py-2 rounded-md font-medium text-sm transition hover:bg-indigo-600 text-white';
            });
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            document.getElementById('nav-' + tabId).className = 'px-4 py-2 rounded-md font-medium text-sm transition bg-white text-indigo-700 shadow';
        }

        function renderTasks() {
            // Render Today's Tasks
            const todayList = document.getElementById('today-tasks-list');
            const todayTasks = tasks.filter(t => t.task_date === todayStr);
            
            if (todayTasks.length === 0) {
                todayList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">No tasks scheduled for today.</div>`;
            } else {
                todayList.innerHTML = todayTasks.map(t => `
                    <div class="py-3 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" ${t.status === 'completed' ? 'checked' : ''} onchange="toggleTask(${t.id})" class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                            <span class="${t.status === 'completed' ? 'line-through text-slate-400' : 'text-slate-800'} font-medium text-sm">${t.title}</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${t.status === 'completed' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'} capitalize">${t.status}</span>
                            <button onclick="deleteTask(${t.id})" class="text-slate-400 hover:text-red-500 transition text-sm"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>
                `).join('');
            }

            // Render All Tasks (Sorted by Date descending/ascending)
            const allList = document.getElementById('all-tasks-list');
            const sortedTasks = [...tasks].sort((a, b) => new Date(b.task_date) - new Date(a.task_date));

            if (sortedTasks.length === 0) {
                allList.innerHTML = `<div class="py-8 text-center text-slate-400 text-sm">No tasks found in the database.</div>`;
            } else {
                allList.innerHTML = sortedTasks.map(t => `
                    <div class="py-3 flex items-center justify-between">
                        <div>
                            <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded mr-2">[${t.task_date}]</span>
                            <span class="${t.status === 'completed' ? 'line-through text-slate-400' : 'text-slate-800'} font-medium text-sm">${t.title}</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold ${t.status === 'completed' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'} capitalize">${t.status}</span>
                            <button onclick="deleteTask(${t.id})" class="text-slate-400 hover:text-red-500 transition text-sm"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function toggleTask(id) {
            const task = tasks.find(t => t.id === id);
            if (task) {
                task.status = task.status === 'completed' ? 'pending' : 'completed';
                saveTasks();
            }
        }

        function deleteTask(id) {
            tasks = tasks.filter(t => t.id !== id);
            saveTasks();
        }

        function openAddTaskModal() {
            document.getElementById('taskModal').classList.remove('hidden');
        }

        function closeAddTaskModal() {
            document.getElementById('taskModal').classList.add('hidden');
        }

        function handleAddTask(e) {
            e.preventDefault();
            const newTask = {
                id: Date.now(),
                title: document.getElementById('taskTitle').value,
                task_date: document.getElementById('taskDate').value,
                status: document.getElementById('taskStatus').value
            };
            tasks.push(newTask);
            saveTasks();
            closeAddTaskModal();
            document.getElementById('taskForm').reset();
            document.getElementById('taskDate').value = todayStr;
        }

        // Initial render
        renderTasks();
    </script>
</body>
</html>
